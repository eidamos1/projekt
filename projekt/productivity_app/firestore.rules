rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Uzivatelsky profil
    match /users/{uid} {
      allow read: if request.auth != null;
      // Vlastnik muze vse, ostatni prihlaseni mohou updatovat (confirm flow prida XP/coins)
      allow create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null;

      // Ukoly uzivatele
      match /tasks/{taskId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        // Update — vlastnik (editace) i jiny prihlaseny (potvrzeni ukolu)
        allow update: if request.auth != null;
      }

      // Notifikace uzivatele
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == uid;
        // Delete — vlastnik inboxu, nebo puvodni odesilatel
        // (`fromUid`). Druhy pripad je nutny pro friend-feed cleanup, kdy
        // vlastnik tasku maze friend_pending notifs ze vsech kamaradskych
        // inboxu po potvrzeni/odmiteni.
        allow delete: if request.auth != null
                      && (request.auth.uid == uid
                          || (resource.data.fromUid is string
                              && request.auth.uid == resource.data.fromUid));
      }

      // Navyky uzivatele — owner plne, ostatni jen cteni (nutne pro habit-streak update v confirm flow)
      match /habits/{habitId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null;
      }

      // Odemknute achievementy — read jakymkoliv auth (potreba pro
      // friend profile view + count aggregace), write pouze vlastnik.
      // Predikat eval bezi na zarizeni vlastnika.
      match /achievements/{achievementId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Globalni kolekce pro vyhledavani kodu ukolu
    match /taskCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['userId', 'taskId'])
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Globalni invite-code index pro friend invite linky
    match /userInvites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.keys().hasOnly(['userId']);
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

    // Friend edges — kazdy uzivatel vidi vlastni list. Mutual write
    // (oba edge): bud vlastnik subkolekce nebo druhy uzivatel z paru.
    match /users/{userId}/friends/{friendId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && (request.auth.uid == userId
                                || request.auth.uid == friendId);
      allow delete: if request.auth != null
                    && (request.auth.uid == userId
                        || request.auth.uid == friendId);
    }
  }
}
