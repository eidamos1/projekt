rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Uzivatelsky profil
    match /users/{uid} {
      allow read: if request.auth != null;
      // Vlastnik muze vse, ostatni prihlaseni mohou updatovat (confirm flow prida XP/coins)
      allow create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null;

      // Ukoly uzivatele
      match /tasks/{taskId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        // Update — vlastnik (editace) i jiny prihlaseny (potvrzeni ukolu)
        allow update: if request.auth != null;
      }

      // Notifikace uzivatele
      match /notifications/{notifId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == uid;
      }

      // Navyky uzivatele — owner plne, ostatni jen cteni (nutne pro habit-streak update v confirm flow)
      match /habits/{habitId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null;
      }

      // Odemknute achievementy — pouze vlastnik. Predikat eval bezi na zarizeni vlastnika.
      match /achievements/{achievementId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Globalni kolekce pro vyhledavani kodu ukolu
    match /taskCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['userId', 'taskId'])
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }
  }
}
